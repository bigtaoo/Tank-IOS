CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
ENABLE_USER_SCRIPT_SANDBOXING = NO
EXCLUDED_ARCHS[sdk=iphoneos*] = i386 x86_64
FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/Google-Mobile-Ads-SDK" "${PODS_ROOT}/Ads-Global/SDK" "${PODS_ROOT}/AppLovinSDK/applovin-ios-sdk-13.5.0" "${PODS_ROOT}/FBAudienceNetwork/Static" "${PODS_ROOT}/GDTMobSDK/GDTFramework" "${PODS_ROOT}/Google-Mobile-Ads-SDK/Frameworks/GoogleMobileAdsFramework" "${PODS_ROOT}/GoogleUserMessagingPlatform/Frameworks/Release" "${PODS_ROOT}/IronSourceAdMobAdapter/ISAdMobAdapter" "${PODS_ROOT}/IronSourceAdQualitySDK" "${PODS_ROOT}/IronSourceAppLovinAdapter/ISAppLovinAdapter" "${PODS_ROOT}/IronSourceFacebookAdapter/ISFacebookAdapter" "${PODS_ROOT}/IronSourcePangleAdapter/ISPangleAdapter" "${PODS_ROOT}/IronSourceSDK/IronSource" "${PODS_ROOT}/IronSourceTencentAdapter/ISTencentAdapter" "${PODS_ROOT}/IronSourceUnityAdsAdapter/ISUnityAdsAdapter" "${PODS_ROOT}/UnityAds" "${PODS_XCFRAMEWORKS_BUILD_DIR}/Ads-Global/PangleSDK" "${PODS_XCFRAMEWORKS_BUILD_DIR}/Ads-Global/TikTokBusinessSDK" "${PODS_XCFRAMEWORKS_BUILD_DIR}/AppLovinSDK" "${PODS_XCFRAMEWORKS_BUILD_DIR}/FBAudienceNetwork" "${PODS_XCFRAMEWORKS_BUILD_DIR}/GDTMobSDK" "${PODS_XCFRAMEWORKS_BUILD_DIR}/Google-Mobile-Ads-SDK" "${PODS_XCFRAMEWORKS_BUILD_DIR}/GoogleUserMessagingPlatform" "${PODS_XCFRAMEWORKS_BUILD_DIR}/IronSourceAdMobAdapter" "${PODS_XCFRAMEWORKS_BUILD_DIR}/IronSourceAppLovinAdapter" "${PODS_XCFRAMEWORKS_BUILD_DIR}/IronSourceFacebookAdapter" "${PODS_XCFRAMEWORKS_BUILD_DIR}/IronSourcePangleAdapter" "${PODS_XCFRAMEWORKS_BUILD_DIR}/IronSourceSDK/Ads" "${PODS_XCFRAMEWORKS_BUILD_DIR}/IronSourceTencentAdapter" "${PODS_XCFRAMEWORKS_BUILD_DIR}/IronSourceUnityAdsAdapter" "${PODS_XCFRAMEWORKS_BUILD_DIR}/UnityAds"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
HEADER_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/Google-Mobile-Ads-SDK/Google_Mobile_Ads_SDK.framework/Headers" "${PODS_ROOT}/Headers/Public" "${PODS_ROOT}/Headers/Public/IronSourceAdQualitySDK" "${PODS_XCFRAMEWORKS_BUILD_DIR}/IronSourceAdQualitySDK/Headers" ${PODS_ROOT}/GDTMobSDK/GDTFramework/GDTMobSDK.xcframework/ios-arm64/GDTMobSDK.framework/Headers ${PODS_ROOT}/GDTMobSDK/GDTFramework/Tquic.xcframework/ios-arm64_armv7/Tquic.framework/Headers
LD_RUNPATH_SEARCH_PATHS = $(inherited) /usr/lib/swift '@executable_path/Frameworks' '@loader_path/Frameworks' '@executable_path/../../Frameworks'
LIBRARY_SEARCH_PATHS = $(inherited) "${PODS_XCFRAMEWORKS_BUILD_DIR}/IronSourceAdQualitySDK" "${TOOLCHAIN_DIR}/usr/lib/swift/${PLATFORM_NAME}" /usr/lib/swift
OTHER_LDFLAGS = $(inherited) -ObjC -l"IronSourceAdQuality" -l"bz2" -l"c++" -l"c++abi" -l"iconv" -l"resolv" -l"sqlite3" -l"sqlite3.0" -l"xml2" -l"z" -framework "AVFAudio" -framework "AVFoundation" -framework "Accelerate" -framework "AdSupport" -framework "AppLovinSDK" -framework "AppTrackingTransparency" -framework "AudioToolbox" -framework "CFNetwork" -framework "CoreFoundation" -framework "CoreGraphics" -framework "CoreHaptics" -framework "CoreImage" -framework "CoreLocation" -framework "CoreMedia" -framework "CoreMotion" -framework "CoreTelephony" -framework "CoreVideo" -framework "FBAudienceNetwork" -framework "Foundation" -framework "GDTMobSDK" -framework "GoogleMobileAds" -framework "Google_Mobile_Ads_SDK" -framework "ISAdMobAdapter" -framework "ISAppLovinAdapter" -framework "ISFacebookAdapter" -framework "ISPangleAdapter" -framework "ISTencentAdapter" -framework "ISUnityAdsAdapter" -framework "IronSource" -framework "JavaScriptCore" -framework "MediaPlayer" -framework "MessageUI" -framework "MobileCoreServices" -framework "Network" -framework "PAGAdSDK" -framework "QuartzCore" -framework "SafariServices" -framework "Security" -framework "StoreKit" -framework "SystemConfiguration" -framework "TikTokBusinessSDK" -framework "Tquic" -framework "UIKit" -framework "UnityAds" -framework "UserMessagingPlatform" -framework "WebKit" -weak_framework "AdSupport" -weak_framework "AppTrackingTransparency" -weak_framework "CFNetwork" -weak_framework "CoreML" -weak_framework "CoreMotion" -weak_framework "CoreTelephony" -weak_framework "DeviceCheck" -weak_framework "JavaScriptCore" -weak_framework "LocalAuthentication" -weak_framework "SafariServices" -weak_framework "SystemConfiguration" -weak_framework "VideoToolbox" -weak_framework "WebKit"
OTHER_MODULE_VERIFIER_FLAGS = $(inherited) "-F${PODS_CONFIGURATION_BUILD_DIR}/Ads-Global" "-F${PODS_CONFIGURATION_BUILD_DIR}/AppLovinSDK" "-F${PODS_CONFIGURATION_BUILD_DIR}/FBAudienceNetwork" "-F${PODS_CONFIGURATION_BUILD_DIR}/GDTMobSDK" "-F${PODS_CONFIGURATION_BUILD_DIR}/Google-Mobile-Ads-SDK" "-F${PODS_CONFIGURATION_BUILD_DIR}/GoogleUserMessagingPlatform" "-F${PODS_CONFIGURATION_BUILD_DIR}/IronSourceAdMobAdapter" "-F${PODS_CONFIGURATION_BUILD_DIR}/IronSourceAdQualitySDK" "-F${PODS_CONFIGURATION_BUILD_DIR}/IronSourceAppLovinAdapter" "-F${PODS_CONFIGURATION_BUILD_DIR}/IronSourceFacebookAdapter" "-F${PODS_CONFIGURATION_BUILD_DIR}/IronSourcePangleAdapter" "-F${PODS_CONFIGURATION_BUILD_DIR}/IronSourceSDK" "-F${PODS_CONFIGURATION_BUILD_DIR}/IronSourceTencentAdapter" "-F${PODS_CONFIGURATION_BUILD_DIR}/IronSourceUnityAdsAdapter" "-F${PODS_CONFIGURATION_BUILD_DIR}/UnityAds"
OTHER_SWIFT_FLAGS = $(inherited) -D COCOAPODS
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_PODFILE_DIR_PATH = ${SRCROOT}/.
PODS_ROOT = ${SRCROOT}/Pods
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
